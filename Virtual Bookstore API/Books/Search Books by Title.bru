meta {
  name: Search Books by Title
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/books/search/title?title=Clean
  body: none
  auth: inherit
}

params:query {
  title: Clean
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Find all books matching the title keyword (case-insensitive partial match)
}
