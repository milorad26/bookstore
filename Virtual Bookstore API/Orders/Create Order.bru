meta {
  name: Create Order
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userId": 1,
    "orderItems": [
      {
        "title": "Clean Code",
        "author": "Robert C. Martin",
        "quantity": 2
      },
      {
        "title": "Effective Java", 
        "author": "Joshua Bloch",
        "quantity": 1
      }
    ],
    "shippingAddress": "123 Main St, City, State 12345",
    "billingAddress": "123 Main St, City, State 12345",
    "orderNotes": "Please deliver carefully"
  }
}

settings {
  encodeUrl: true
}

docs {
  Create a new order using book title and author. Stock is deducted immediately and order status becomes CONFIRMED. Returns 409 if user already has a pending order.
}