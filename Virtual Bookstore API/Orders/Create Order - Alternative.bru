meta {
  name: Create Order - Alternative
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userId": 1,
    "orderItems": [
      {
        "title": "The Pragmatic Programmer",
        "author": "Andrew Hunt",
        "quantity": 1
      }
    ],
    "shippingAddress": "456 Oak Ave, City, State 12345",
    "billingAddress": "456 Oak Ave, City, State 12345",
    "orderNotes": "Order example"
  }
}

settings {
  encodeUrl: true
}

docs {
  Alternative example of creating an order with different book selection. Stock is deducted immediately upon order creation.
}