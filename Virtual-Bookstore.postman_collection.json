{
	"info": {
		"_postman_id": "virtual-bookstore-api",
		"name": "Virtual Bookstore API",
		"description": "Complete API collection for the Virtual Bookstore application. Includes all CRUD operations and search functionality for managing books.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
